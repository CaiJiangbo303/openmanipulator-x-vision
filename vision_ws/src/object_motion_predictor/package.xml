<?xml version="1.0"?>
<package format="3">
  <name>object_motion_predictor</name>
  <version>0.0.1</version>

  <description>
    Motion prediction for tracked object states.
  </description>

  <maintainer email="bo@todo.todo">bo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>object_state_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
